digraph DFPS_Mesh {
    rankdir=LR;
    fontsize=10;
    labelloc="t";
    label="DFPS Federated Data Mesh: domain nodes + optional hub";

    node [shape=box, style=rounded];

    // Mesh Hub (optional)
    subgraph cluster_hub {
        label="Mesh Hub (Optional)";
        style=filled;
        color="#fff3e0";

        hub_api   [label="dfps_mesh_hub\nplatform/mesh/hub\n(Research / FL Orchestrator)"];
        hub_store [label="Hub Meta Store\n(Postgres/Redis for jobs)\n(no clinical data)", shape=note];
    }

    // Node 1
    subgraph cluster_node1 {
        label="Mesh Node: Clinic A";
        style=filled;
        color="#e3f2fd";

        node1_api    [label="dfps_mesh_node\n(Axum HTTP)\nlib/platform/mesh/node"];
        node1_gov    [label="dfps_mesh_governance\nplatform/mesh/governance\n(policy sidecar)", shape=component];

        node1_pipeline [label="dfps_pipeline\n(domain)"];
        node1_mart     [label="dfps_mart\nplatform/data/mart"];
        node1_rel      [label="dfps_relational_store\nplatform/store/relational_store"];
        node1_vec      [label="dfps_vector_store\nplatform/store/vector_store"];
        node1_cache    [label="dfps_cache_store\nplatform/store/cache_store", style=dashed];
        node1_graph    [label="dfps_graph_store\nplatform/store/graph_store", style=dashed];
        node1_lake     [label="dfps_lake\nplatform/data/lake", style=dashed];

        node1_api -> node1_gov    [label="all research/FL requests"];
        node1_api -> node1_pipeline [label="FHIR Bundles\n(local ingestion)"];
        node1_pipeline -> node1_mart [label="PipelineOutput\n→ dims/facts"];
        node1_mart -> node1_rel     [label="SQLx\n(dim_*, fact_*)"];

        node1_pipeline -> node1_vec [label="VectorStore trait\n(VectorPipelineContext)"];
        node1_mart -> node1_lake    [label="local Parquet/Delta", style=dashed];

        node1_gov -> node1_mart     [label="allow/deny FL jobs\n& analytics exports"];
        node1_gov -> node1_rel      [label="DP + query policy", style=dashed];
    }

    // Node 2 (another domain)
    subgraph cluster_node2 {
        label="Mesh Node: Hospital B";
        style=filled;
        color="#e8f5e9";

        node2_api    [label="dfps_mesh_node\n(Axum HTTP)"];
        node2_gov    [label="dfps_mesh_governance", shape=component];

        node2_pipeline [label="dfps_pipeline"];
        node2_mart     [label="dfps_mart"];
        node2_rel      [label="dfps_relational_store"];
        node2_vec      [label="dfps_vector_store"];

        node2_api -> node2_gov;
        node2_api -> node2_pipeline;
        node2_pipeline -> node2_mart;
        node2_mart -> node2_rel;
        node2_pipeline -> node2_vec;
        node2_gov -> node2_mart;
    }

    // Contracts and domain shared types
    contracts [label="dfps_contracts\n(domain/contracts)\n(shared DTOs)", shape=ellipse];

    node1_pipeline -> contracts;
    node2_pipeline -> contracts;
    node1_mart     -> contracts;
    node2_mart     -> contracts;
    hub_api        -> contracts;

    // Hub -> Nodes: send FL jobs (code) to nodes
    hub_api -> node1_api [label="FL Job / Query\n(code → data)", color="#ff9800"];
    hub_api -> node2_api [label="FL Job / Query\n(code → data)", color="#ff9800"];

    // Nodes -> Hub: send only aggregates
    node1_gov -> hub_api [label="Aggregated / DP-safe\nresults", color="#4caf50"];
    node2_gov -> hub_api [label="Aggregated / DP-safe\nresults", color="#4caf50"];

    // External engines per node (not shown exhaustively)
    qdrant   [label="Qdrant", shape=note];
    pg       [label="Postgres\n(+PGVector)", shape=note];
    duckdb   [label="DuckDB", shape=note];
    redis    [label="Redis", shape=note];
    s3       [label="Local S3/GCS-like\nfor node", shape=note];

    node1_vec -> qdrant  [label="HTTP API"];
    node1_rel -> pg      [label="SQLx"];
    node1_rel -> duckdb  [label="optional local OLAP", style=dashed];
    node1_cache -> redis [label="cache", style=dashed];
    node1_lake -> s3     [label="object storage", style=dashed];

    node2_vec -> pg      [label="PGVector", style=dashed];
}
