### Vector store (VEC-013 / VEC-02) – Qdrant/mock settings
# DFPS_VECTOR_ENABLED=true
# DFPS_VECTOR_BACKEND=qdrant
# DFPS_VECTOR_URL=http://localhost:6333
# DFPS_VECTOR_NAMESPACE=ncit_dev
# DFPS_VECTOR_POOL_MAX=5
# DFPS_VECTOR_HEALTH_TIMEOUT_MS=500

### Optional: switch to mock backend for offline smoke
# DFPS_VECTOR_ENABLED=false
# DFPS_VECTOR_BACKEND=mock

# Pgvector (local Postgres + extension)
# Uncomment to use pgvector instead of Qdrant; ensure the vector extension is installed and DDL applied.
# DFPS_VECTOR_ENABLED=true
# DFPS_VECTOR_BACKEND=pgvector
# DFPS_VECTOR_URL=postgres://vector:vector@localhost:5432/vector
# DFPS_VECTOR_NAMESPACE=ncit_dev
# DFPS_VECTOR_POOL_MAX=5
# DFPS_VECTOR_HEALTH_TIMEOUT_MS=500
