### Vector store (VEC-013 / VEC-02) – Qdrant/mock settings
# refractive_swan_VECTOR_ENABLED=true
# refractive_swan_VECTOR_BACKEND=qdrant
# refractive_swan_VECTOR_URL=http://localhost:6333
# refractive_swan_VECTOR_NAMESPACE=ncit_dev
# refractive_swan_VECTOR_POOL_MAX=5
# refractive_swan_VECTOR_HEALTH_TIMEOUT_MS=500

### Optional: switch to mock backend for offline smoke
# refractive_swan_VECTOR_ENABLED=false
# refractive_swan_VECTOR_BACKEND=mock

# Pgvector (local Postgres + extension)
# Uncomment to use pgvector instead of Qdrant; ensure the vector extension is installed and DDL applied.
# refractive_swan_VECTOR_ENABLED=true
# refractive_swan_VECTOR_BACKEND=pgvector
# refractive_swan_VECTOR_URL=postgres://vector:vector@localhost:5432/vector
# refractive_swan_VECTOR_NAMESPACE=ncit_dev
# refractive_swan_VECTOR_POOL_MAX=5
# refractive_swan_VECTOR_HEALTH_TIMEOUT_MS=500
