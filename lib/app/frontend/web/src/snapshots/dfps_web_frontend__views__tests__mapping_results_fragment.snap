source: lib/app/frontend/web/src/views.rs
expression: render_results_fragment(&ctx)
---
<div class="bg-white shadow rounded-xl p-6 space-y-6"><h2 class="text-xl font-semibold">MappingResult rows</h2><div class="grid gap-4 md:grid-cols-3"><div class="rounded-lg border border-slate-200 p-4"><p class="text-sm font-mono text-slate-500">stg_servicerequest_flat</p><p class="text-2xl font-semibold">2</p><p class="text-xs text-slate-500 mt-1">ServiceRequest rows produced by ingestion.</p></div><div class="rounded-lg border border-slate-200 p-4"><p class="text-sm font-semibold text-slate-600">ServiceRequest.status</p><ul class="mt-2 space-y-1"><li class="flex justify-between text-sm"><span>active</span><span class="font-medium">2</span></li></ul></div><div class="rounded-lg border border-slate-200 p-4"><p class="text-sm font-semibold text-slate-600">ServiceRequest.intent</p><ul class="mt-2 space-y-1"><li class="flex justify-between text-sm"><span>order</span><span class="font-medium">2</span></li></ul></div></div><div class="overflow-x-auto"><table class="min-w-full divide-y divide-slate-200"><thead class="bg-slate-50"><tr><th class="px-4 py-2 text-left text-xs font-semibold uppercase tracking-wide text-slate-600">ServiceRequest (sr_id)</th><th class="px-4 py-2 text-left text-xs font-semibold uppercase tracking-wide text-slate-600">Code element</th><th class="px-4 py-2 text-left text-xs font-semibold uppercase tracking-wide text-slate-600">NCIt concept</th><th class="px-4 py-2 text-left text-xs font-semibold uppercase tracking-wide text-slate-600">Mapping state</th></tr></thead><tbody class="divide-y divide-slate-100 bg-white"><tr><td class="px-4 py-3 align-top"><p class="font-medium">SR-1</p><p class="text-sm text-slate-500">http://loinc.org</p></td><td class="px-4 py-3 align-top"><p class="font-semibold">24606-6</p><p class="text-sm text-slate-500">FDG uptake</p></td><td class="px-4 py-3 align-top"><p class="font-medium">C1234</p><p class="text-sm text-slate-500">FDG Uptake</p></td><td class="px-4 py-3 align-top"><span title="Met lexical + semantic thresholds using NCIt and mock UMLS xrefs." class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset bg-emerald-100 text-emerald-900 ring-emerald-200">AutoMapped</span></td></tr><tr><td class="px-4 py-3 align-top"><p class="font-medium">SR-2</p><p class="text-sm text-slate-500">http://loinc.org</p></td><td class="px-4 py-3 align-top"><p class="font-semibold">99999-9</p><p class="text-sm text-slate-500">Unknown code</p></td><td class="px-4 py-3 align-top"><span class="text-slate-400">--</span></td><td class="px-4 py-3 align-top"><span title="Pipeline could not locate an NCIt concept for the supplied code." class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset bg-rose-100 text-rose-900 ring-rose-200">No match</span><p class="mt-1 text-xs text-slate-500">MappingResult.reason: missing_system_or_code</p></td></tr></tbody></table></div></div>
