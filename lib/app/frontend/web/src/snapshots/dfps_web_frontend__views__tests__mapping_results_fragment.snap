<div class="bg-white shadow-academic rounded-md border border-gray-200"><div class="bg-navy-50 px-6 py-3 border-b border-gray-200 flex items-center justify-between"><h2 class="text-lg font-serif font-bold text-navy-900">Mapping Results</h2><span class="text-xs font-mono text-gray-500">Total: 2</span></div><div class="p-4 grid gap-3 md:grid-cols-3 border-b border-gray-100"><div class="rounded-md border border-gray-200 p-3"><p class="text-xs font-mono text-gray-500 uppercase">stg_servicerequest_flat</p><p class="text-xl font-serif font-bold mt-1">2</p></div><div class="rounded-md border border-gray-200 p-3"><p class="text-xs font-semibold text-gray-600 uppercase">SR Status</p><ul class="mt-2 space-y-1 text-xs"><li class="flex justify-between"><span>active</span><span class="font-medium">2</span></li></ul></div><div class="rounded-md border border-gray-200 p-3"><p class="text-xs font-semibold text-gray-600 uppercase">SR Intent</p><ul class="mt-2 space-y-1 text-xs"><li class="flex justify-between"><span>order</span><span class="font-medium">2</span></li></ul></div></div><div class="overflow-x-auto"><table class="min-w-full divide-y divide-gray-200 text-sm"><thead class="bg-gray-50"><tr><th class="px-3 py-2 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">ServiceRequest</th><th class="px-3 py-2 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Code Element</th><th class="px-3 py-2 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">NCIt Concept</th><th class="px-3 py-2 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">State</th></tr></thead><tbody class="bg-white divide-y divide-gray-200"><tr class="hover:bg-gray-50 hover:border-l-4 hover:border-l-navy-900 transition-all duration-150 cursor-pointer"><td class="px-3 py-2 text-xs text-gray-600"><div class="font-mono text-xs font-medium text-navy-900">SR-1</div><div class="text-xs text-gray-500">http://loinc.org</div></td><td class="px-3 py-2 text-xs text-gray-600"><div class="font-mono text-xs font-semibold">24606-6</div><div class="text-xs text-gray-500">FDG uptake</div></td><td class="px-3 py-2 text-xs text-gray-600"><div class="font-mono text-xs font-medium text-navy-900">C1234</div><div class="text-xs text-gray-600">FDG Uptake</div></td><td class="px-3 py-2 text-xs text-gray-600"><span class="inline-flex items-center rounded px-2 py-0.5 text-xs font-medium border bg-emerald-50 text-emerald-800 border-emerald-100">auto_mapped</span></td></tr><tr class="hover:bg-gray-50 hover:border-l-4 hover:border-l-navy-900 transition-all duration-150 cursor-pointer"><td class="px-3 py-2 text-xs text-gray-600"><div class="font-mono text-xs font-medium text-navy-900">SR-2</div><div class="text-xs text-gray-500">http://loinc.org</div></td><td class="px-3 py-2 text-xs text-gray-600"><div class="font-mono text-xs font-semibold">99999-9</div><div class="text-xs text-gray-500">Unknown code</div></td><td class="px-3 py-2 text-xs text-gray-600"><span class="text-gray-400 italic">-</span></td><td class="px-3 py-2 text-xs text-gray-600"><span class="inline-flex items-center rounded px-2 py-0.5 text-xs font-medium border bg-rose-50 text-rose-800 border-rose-100">no_match</span><div class="mt-1 text-xs text-rose-600 font-medium">missing_system_or_code</div></td></tr></tbody></table></div></div>
